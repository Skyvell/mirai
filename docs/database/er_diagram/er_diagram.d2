vars: {
  d2-config: {
    layout-engine: elk
    dark-theme-id: 200
    pad: 0
    theme-overrides: {
      B4: "#d9e0de"
      N1: "#557770"
      N2: "#566a65"
      N7: "#ffffff"
      B1: "#0f9488"
      B2: "#1c2b29"
      AA2: "#0f9488"
    }
    dark-theme-overrides: {
      B4: "#1b1c1f"
      N1: "#1f4d44"
      N2: "#b3c2be"
      N7: "#3a4945"
      B1: "#4fb3a3"
      B2: "#eef3f1"
      AA2: "#6fcab9"
    }
  }
}

classes: {
  table: {
    shape: sql_table
    style: {
      border-radius: 10
      shadow: true
      stroke-width: 1
      font-color: "#f4f7f6"
    }
  }
  fk: {
    source-arrowhead: N {shape: cf-many; style.font-color: "#0b7f75"}
    target-arrowhead: 1 {shape: cf-one-required; style.font-color: "#0b7f75"}
    style.stroke-width: 2
  }
  optional: {
    target-arrowhead: 0..1 {shape: cf-one; style.font-color: "#0b7f75"}
  }
}

schema: Mirai data model {
  style: {
    stroke-width: 0
    font-size: 40
    font-color: "#557770"
    bold: true
  }

  users: {
    class: table
    id: uuid {constraint: primary_key}
    clerk_user_id: text {constraint: unique}
    sex: enum(sex)?
    date_of_birth: date?
    created_at: timestamptz
  }

  biomarker_catalogue: {
    class: table
    id: uuid {constraint: primary_key}
    slug: text {constraint: unique}
    display_name: text
    loinc_code: text?
    canonical_unit: text
    category: text
  }

  lab_uploads: {
    class: table
    id: uuid {constraint: primary_key}
    user_id: uuid {constraint: foreign_key}
    filename: text
    content_sha256: text?
    status: enum(lab_upload_status)
    measured_at: date?
    error_message: text?
    parsed_at: timestamptz?
    confirmed_at: timestamptz?
    created_at: timestamptz
  }

  lab_results: {
    class: table
    id: uuid {constraint: primary_key}
    lab_upload_id: uuid {constraint: foreign_key}
    biomarker_id: uuid? {constraint: foreign_key}
    value: numeric(12,4)?
    raw_value: text?
    unit: text?
    reference_low: numeric(12,4)?
    reference_high: numeric(12,4)?
    source_name: text?
    included: boolean
    created_at: timestamptz
    updated_at: timestamptz
  }

  biomarker_measurements: {
    class: table
    id: uuid {constraint: primary_key}
    user_id: uuid {constraint: foreign_key}
    biomarker_id: uuid {constraint: foreign_key}
    lab_upload_id: uuid? {constraint: foreign_key}
    value: numeric(12,4)
    unit: text
    reference_low: numeric(12,4)?
    reference_high: numeric(12,4)?
    measured_at: date
    created_at: timestamptz
    updated_at: timestamptz
  }

  biomarker_intervals: {
    class: table
    id: uuid {constraint: primary_key}
    biomarker_id: uuid {constraint: foreign_key}
    type: enum(interval_type)
    sex: enum(sex)
    age_min_days: integer
    age_max_days: integer?
    interval_low: numeric(12,4)?
    interval_high: numeric(12,4)?
    source: text
    source_url: text?
    created_at: timestamptz
    updated_at: timestamptz
  }

  lab_uploads.user_id <-> users: {class: fk}
  biomarker_measurements.user_id <-> users: {class: fk}
  biomarker_intervals.biomarker_id <-> biomarker_catalogue: {class: fk}
  lab_results.biomarker_id <-> biomarker_catalogue: {class: [fk; optional]}
  biomarker_measurements.biomarker_id <-> biomarker_catalogue: {class: fk}
  lab_results.lab_upload_id <-> lab_uploads: {class: fk}
  biomarker_measurements.lab_upload_id <-> lab_uploads: {class: [fk; optional]}
}
